" plugins configure

" colorscheme gruvbox
" colorscheme badwolf
colorscheme molokai

let g:NERDTreeDirArrows=0
let g:NERDTreeChDirMode=2
let g:NERDTreeRemoveFileCmd="mv -t /tmp/ "
let g:NERDTreeRemoveDirCmd="mv -t /tmp/ "
" let NERDTreeIgnore = ['\.pyc$']
noremap tt :NERDTreeToggle<CR>
noremap ff :NERDTreeFind<CR>

let NERDSpaceDelims = 1  " add space after comment delim for pep8
" For same reason vim registers <C-/> as <C-_>
noremap <C-_> :call NERDComment(0, "toggle")<cr>

noremap TT :TagbarToggle<CR>
let g:tagbar_autofocus = 1
let g:tagbar_autoclose = 1
let g:tagbar_foldlevel = 0

let g:ctrlp_map = '<C-P>'
let g:ctrlp_cmd = 'CtrlP'
let g:ctrlp_tabpage_position  = 'a'
let g:ctrlp_working_path_mode = 'ra'
if executable('fd')
  let g:ctrlp_user_command = 'fd --type f'
else
  let g:ctrlp_user_command = 'find %s -type f'
endif

" vim-gitgutter
let g:gitgutter_map_keys = 0
let g:gitgutter_sign_priority = 5
nnoremap <leader>hn :GitGutterNextHunk<CR>
nnoremap <leader>hp :GitGutterPrevHunk<CR>
nnoremap <leader>hv :GitGutterPreviewHunk<CR>
nnoremap <leader>hs :GitGutterStageHunk<CR>
nnoremap <leader>hu :GitGutterUndoHunk<CR>

" ALE: Asynchronous Lint Engine
let g:ale_linters = {
\    'python': ['pylint'],
\    'sh': ['shellcheck'],
\    'make': ['checkmake'],
\    'dockerfile': ['hadolint'],
\    'yaml': ['yamllint'],
\}

augroup user_ale
  autocmd!
  " Enable actionlint only for GitHub workflow YAML files.
  autocmd BufRead,BufNewFile */.github/*/*.y{,a}ml let b:ale_linters = {'yaml': ['yamllint', 'actionlint']}
augroup END

let g:ale_lint_on_enter = 0
let g:ale_lint_on_text_changed = 'never'
let g:ale_lint_on_insert_leave = 0
let g:ale_lint_on_save = 1
let g:ale_fix_on_save = 0
let g:ale_fixers = {
\   '*': ['remove_trailing_lines', 'trim_whitespace'],
\   'python': ['black'],
\   'css': ['prettier'],
\   'json': ['prettier'],
\   'yaml': ['prettier'],
\}
let g:ale_completion_enabled = 0
let g:ale_sign_column_always = 1
let g:ale_echo_msg_format = '[ALE][%severity%][%linter%] %s'
nnoremap <F10> :ALEGoToDefinition<CR>
nnoremap <F11> :ALEFindReferences<CR>

" vim-fugitive uses its default commands and mappings.

" indentLine
" https://github.com/Yggdroot/indentLine
" toggle with :IndentLinesToggle
let g:indentLine_enabled = 1
let g:indentLine_char_list = ['|', '¦', '┆', '┊']
" vim default 0: off, indentLine set it to 2, which will hide quotes in json file
let g:indentLine_conceallevel = 2
let g:indentLine_concealcursor = 'inc'
" enable indentLine, while still show quotes for json and markdown
let g:vim_json_conceal = 0
let g:markdown_syntax_conceal = 0
